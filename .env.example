# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật của bạn.
# ".env" đã bị .gitignore - không commit lên git, mỗi người tự giữ key riêng.
#
# Chọn 1 nhà cung cấp có host model mở deepseek-r1-distill-qwen-32b (hoặc model
# khác nếu muốn), điền đúng base_url + api_key + model slug của nhà đó.
# Kiểm tra lại tên model slug chính xác trên trang docs/model-list của provider
# trước khi dùng - tên có thể khác đôi chút tuỳ nơi host. Vài lựa chọn phổ biến:
#
#   OpenRouter   base_url = https://openrouter.ai/api/v1
#                model    = deepseek/deepseek-r1-distill-qwen-32b
#
#   Together AI  base_url = https://api.together.xyz/v1
#                model    = deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
#
#   Fireworks AI base_url = https://api.fireworks.ai/inference/v1
#                model    = accounts/fireworks/models/deepseek-r1-distill-qwen-32b
#
#   DeepInfra    base_url = https://api.deepinfra.com/v1/openai
#                model    = deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
#
# Cũng có thể trỏ sang bất kỳ model/provider OpenAI-compatible nào khác (kể cả
# Claude/GPT qua gateway riêng của bạn) - code trong workspace/llm_helper.py
# không phụ thuộc vào provider cụ thể nào.

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek/deepseek-r1-distill-qwen-32b
