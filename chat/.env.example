# Copy file này thành ".env" (cùng thư mục) rồi điền key thật của bạn.
# ".env" đã bị .gitignore - không commit lên git, mỗi người tự giữ key riêng.
#
# Server thử LLM_1 trước; nếu lỗi/hết quota thì tự chuyển sang LLM_2, LLM_3...
# Provider nào để trống hoặc còn giá trị mẫu ("your-...") thì bị bỏ qua, nên
# không cần điền đủ cả 4. Muốn đổi thứ tự thì đổi số. Sửa xong phải bật lại server.py.
#
# Quota free (kiểm tra lần cuối 09/2026 - các nhà cung cấp hay đổi):
#   1. Cloudflare  ~10-20 câu/ngày   đúng model của đề thi Final
#   2. Groq        1.000 req/ngày    nhưng chỉ 8K token/phút, 200K token/ngày
#   3. OpenRouter  50 req/ngày       cùng model với Groq, đỡ khi Groq bị giới hạn/phút
#   4. NVIDIA      ~40 req/phút      model reasoning cỡ 30B, khác họ - dự phòng cuối
# Tổng cộng đủ 50-100 câu/buổi cho mỗi người.

# --- 1. Cloudflare Workers AI: deepseek-r1-distill-qwen-32b (đúng model thi) ---
# Lấy key: dash.cloudflare.com -> AI -> Workers AI -> Use REST API
#          -> Create a Workers AI API Token; Account ID nằm cùng trang.
LLM_1_NAME=Cloudflare
LLM_1_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LLM_1_API_KEY=your-cloudflare-api-token
LLM_1_MODEL=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b

# --- 2. Groq: Qwen3.8 27B (reasoning, cùng họ Qwen với bản gốc) ---
# Lấy key: console.groq.com -> API Keys -> Create API Key (không cần thẻ).
LLM_2_NAME=Groq
LLM_2_BASE_URL=https://api.groq.com/openai/v1
LLM_2_API_KEY=your-groq-api-key
LLM_2_MODEL=qwen/qwen3.8-27b

# --- 3. OpenRouter: cùng model Qwen3.8 27B, bản free ---
# Lấy key: openrouter.ai -> Settings -> Keys -> Create Key (không cần thẻ).
LLM_3_NAME=OpenRouter
LLM_3_BASE_URL=https://openrouter.ai/api/v1
LLM_3_API_KEY=your-openrouter-api-key
LLM_3_MODEL=qwen/qwen3.8-27b:free

# --- 4. NVIDIA NIM: Nemotron 3 Nano 30B reasoning ---
# Lấy key: build.nvidia.com -> đăng nhập -> Get API Key (key dạng "nvapi-...").
LLM_4_NAME=NVIDIA
LLM_4_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_4_API_KEY=your-nvidia-api-key
LLM_4_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Tuỳ chọn: tự khoá chat sau N giờ kể từ lúc bật server (luật Final: 5), đổi port.
# CHAT_LOCK_AFTER_HOURS=5
# CHAT_PORT=8000
